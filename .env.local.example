# Site public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Préversion privée de démonstration uniquement. Ne pas activer en production réelle.
# PREVIEW_PASSWORD : au moins 16 caractères, distinct de tout mot de passe administratif.
PREVIEW_MODE=false
PREVIEW_USERNAME=visiteur
PREVIEW_PASSWORD=
# Origines supplémentaires autorisées pour les formulaires (URL exactes séparées par des virgules)
FORM_ALLOWED_ORIGINS=

# Initiation : lecture seule du flux privé Google, confirmation par mail, règlement sur place.
# Ne jamais publier cette URL dans une variable NEXT_PUBLIC_ ni dans Git.
INITIATION_CALENDAR_ICS_URL=

# Avant déploiement, comparer toutes les migrations de supabase/migrations
# avec l'historique de la base cible et appliquer celles qui manquent dans l'ordre.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Back-office de contenu local : fichier SQLite hors du dossier public.
# En production, renseigner un chemin absolu sur un volume persistant et sauvegardé.
# En développement, la valeur vide utilise .data/backoffice.sqlite.
BACKOFFICE_DB_PATH=
# Facultatif : chemin absolu partagé entre worktrees pour les états locaux (et son catalogue .states.json).
SITE_CONDITIONS_LOCAL_PATH=

# Envoi des demandes : choisir brevo ou smtp et compléter le fournisseur choisi.
EMAIL_TO=golf@marcilly.com
EMAIL_TO_NAME=Golf de Marcilly
EMAIL_FROM=golf@marcilly.com
EMAIL_FROM_NAME=Golf de Marcilly
RESTAURANT_RESERVATION_EMAIL_TO=golf@marcilly.com
RESTAURANT_RESERVATION_EMAIL_TO_NAME=Golf de Marcilly
MAIL_PROVIDER=brevo
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Diagnostic interne et file de secours persistante dans Supabase.
OPS_CRON_TOKEN=
FALLBACK_QUEUE_ALERT_EMAIL=
FALLBACK_QUEUE_RETENTION_DAYS=14

# Intégrations facultatives
NEXT_PUBLIC_CALENDAR_EMBED_URL=
NEXT_PUBLIC_INITIATION_CALENDAR_EMBED_URL=
