# Site public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origines supplémentaires autorisées pour les formulaires (URL exactes séparées par des virgules)
FORM_ALLOWED_ORIGINS=

# Initiation : lecture seule du flux privé Google, confirmation par mail, règlement sur place.
# Ne jamais publier cette URL dans une variable NEXT_PUBLIC_ ni dans Git.
INITIATION_CALENDAR_ICS_URL=

# Administration des compétitions et protections de production : appliquer aussi
# supabase/migrations/20260925100000_contact_queue_and_rate_limit.sql avant déploiement.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Envoi des demandes : choisir brevo ou smtp et compléter le fournisseur choisi.
EMAIL_TO=golf@marcilly.com
EMAIL_TO_NAME=Golf de Marcilly
EMAIL_FROM=golf@marcilly.com
EMAIL_FROM_NAME=Golf de Marcilly
RESTAURANT_RESERVATION_EMAIL_TO=golf@marcilly.com
RESTAURANT_RESERVATION_EMAIL_TO_NAME=Golf de Marcilly
MAIL_PROVIDER=brevo
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Diagnostic interne et file de secours persistante dans Supabase.
OPS_CRON_TOKEN=
FALLBACK_QUEUE_ALERT_EMAIL=
FALLBACK_QUEUE_RETENTION_DAYS=14

# Intégrations facultatives
NEXT_PUBLIC_CALENDAR_EMBED_URL=
NEXT_PUBLIC_INITIATION_CALENDAR_EMBED_URL=
NEXT_PUBLIC_GA4_ID=

# Compatibilité des anciennes réservations uniquement. Inutile pour les demandes actuelles.
# Ne pas activer de paiement en ligne pour le parcours d'initiation actuel.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_INITIATION_ID=
INITIATION_PAYMENT_MODE=on_site
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:3000
SUMUP_API_BASE_URL=https://api.sumup.com
